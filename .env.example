# Токен сообщества ВКонтакте
# Получить: Управление сообществом -> Работа с API -> Создать ключ
VK_TOKEN=vk1.a.XXXXXXXX

# VK ID администраторов через запятую (без пробелов)
# Посмотреть свой ID: зайди на vk.com, он в адресной строке профиля
ADMIN_IDS=123456789

# ID группы ВКонтакте (число из адреса vk.com/clubXXXXXX)
# Если задан — в главном меню появится кнопка "Поделиться"
VK_GROUP_ID=
